diff --git a/apps/readest-app/src/__tests__/components/settings/CustomTTSServices.test.tsx b/apps/readest-app/src/__tests__/components/settings/CustomTTSServices.test.tsx
new file mode 100644
index e69de29..3065cf0 100644
--- /dev/null
+++ b/apps/readest-app/src/__tests__/components/settings/CustomTTSServices.test.tsx
@@ -0,0 +1,42 @@
+// @vitest-environment happy-dom
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { cleanup, fireEvent, render, screen } from '@testing-library/react';
+
+const store = vi.hoisted(() => ({ services: [] as unknown[] }));
+vi.mock('@/store/customTTSStore', () => ({
+  useCustomTTSStore: (selector: (state: { services: unknown[] }) => unknown) => selector(store),
+  ensureCustomTTSServicesLoaded: vi.fn(),
+}));
+vi.mock('@/hooks/useTranslation', () => ({ useTranslation: () => (s: string) => s }));
+vi.mock('@/context/EnvContext', () => ({ useEnv: () => ({ envConfig: {} }) }));
+vi.mock('@/hooks/useKeyDownActions', () => ({ useKeyDownActions: vi.fn() }));
+// The real AddButton drags in the translator pages; this test is the preset.
+vi.mock('@/components/settings/CustomTranslators', () => ({
+  AddButton: ({ label, onClick }: { label: string; onClick: () => void }) => (
+    <button type='button' onClick={onClick}>
+      {label}
+    </button>
+  ),
+}));
+
+import CustomTTSServices from '@/components/settings/CustomTTSServices';
+
+afterEach(cleanup);
+
+describe('CustomTTSServices', () => {
+  it('opens a MiMo service prefilled from its preset', () => {
+    render(<CustomTTSServices onBack={vi.fn()} />);
+    fireEvent.click(screen.getByText('Add MiMo TTS'));
+    expect((screen.getByLabelText('Name') as HTMLInputElement).value).toBe('MiMo TTS');
+    expect((screen.getByLabelText('Base URL') as HTMLInputElement).value).toBe(
+      'https://api.xiaomimimo.com/v1',
+    );
+    expect((screen.getByLabelText('Model') as HTMLInputElement).value).toBe('mimo-v2.5-tts');
+  });
+
+  it('opens an empty form from the plain add button', () => {
+    render(<CustomTTSServices onBack={vi.fn()} />);
+    fireEvent.click(screen.getByText('Add TTS Service'));
+    expect((screen.getByLabelText('Name') as HTMLInputElement).value).toBe('');
+  });
+});
